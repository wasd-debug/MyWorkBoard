# 复制为 .env 并修改后生效（docker compose 自动读取）
# MySQL root 密码（生产环境请务必修改）
MYSQL_ROOT_PASSWORD=SalaryRoot@2026
# 应用数据库账号密码（后端连接用）
MYSQL_PASSWORD=SalaryApp@2026
# JWT access token 签名密钥（至少 32 字节，生产环境请务必修改）
JWT_SECRET=change-this-to-a-long-random-secret
# AI 凭据加密主密钥；生产环境应使用独立随机值，不能提交真实值
AI_CREDENTIAL_KEY=change-this-to-a-different-long-random-secret
# 默认禁止模型端点访问本机和私网
AI_ALLOW_PRIVATE_NETWORK=false
# 旧数据回填的 admin 账户初始密码（至少 8 位）
LEGACY_ADMIN_PASSWORD=change-this-admin-password
# HTTPS 生产环境设为 true；本地 HTTP 保持 false
COOKIE_SECURE=false

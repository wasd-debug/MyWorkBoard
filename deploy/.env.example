# 复制为 .env 并修改后生效（docker compose 自动读取）
# MySQL root 密码（生产环境请务必修改）
MYSQL_ROOT_PASSWORD=SalaryRoot@2026
# 应用数据库账号密码（后端连接用）
MYSQL_PASSWORD=SalaryApp@2026
# JWT access token 签名密钥（至少 32 字节，生产环境请务必修改）
JWT_SECRET=change-this-to-a-long-random-secret
# JWT access token 有效期（秒），默认 2 小时
JWT_ACCESS_TTL=7200
# Refresh token 有效期（秒），默认 30 天
JWT_REFRESH_TTL=2592000
# AI 凭据加密主密钥；生产环境应使用独立随机值，不能提交真实值
AI_CREDENTIAL_KEY=change-this-to-a-different-long-random-secret
# 默认禁止模型端点访问本机和私网
AI_ALLOW_PRIVATE_NETWORK=false
# 旧数据回填的 admin 账户初始密码（至少 8 位）
LEGACY_ADMIN_PASSWORD=change-this-admin-password
# HTTPS 生产环境设为 true；本地 HTTP 保持 false
COOKIE_SECURE=false
# MCP Streamable HTTP 总开关
APP_MCP_ENABLED=true
# MCP prepare、action 与 R2 commit 开关；生产默认关闭
APP_MCP_WRITE_ENABLED=false
# MCP OAuth 2.1 + PKCE 开关；正式接入前保持关闭
APP_MCP_OAUTH_ENABLED=false
# 网站公开根地址；OAuth 生产环境必须填写真实 HTTPS 域名且不带结尾斜杠
APP_PUBLIC_BASE_URL=
